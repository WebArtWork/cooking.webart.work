{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cooking Ingredient",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aliases",
    "categoryId",
    "subcategoryId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "object",
      "required": [
        "en",
        "ua"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ua": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aliases": {
      "type": "object",
      "required": [
        "en",
        "ua"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "ua": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "categoryId": {
      "type": "string",
      "minLength": 1
    },
    "subcategoryId": {
      "type": "string",
      "minLength": 1
    }
  }
}
