          "unit": "ml"
        }
      ]
    },
    {
      "id": "step-2",
      "instruction": "Розімніть стиглі банани та змішайте з розм’якшеним саго, цукром і сіллю.",
      "techniqueIds": [
        "mashing",
        "mixing"
      ],
