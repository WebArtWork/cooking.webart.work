rules_version = '2';

// Business. Everything is denied unless a rule below allows it.
// Deploy with: npm run rules
service cloud.firestore {
	match /databases/{database}/documents {
		function isOwner(uid) {
			return request.auth != null && request.auth.uid == uid;
		}

		function stringUpTo(value, max) {
			return value is string && value.size() <= max;
		}

		// users/{uid}: the name, email and photo of a Google account. Mirrors src/app/feature/account.
		function validProfile(data) {
			return data.keys().hasOnly(['displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'])
				&& stringUpTo(data.displayName, 200)
				&& stringUpTo(data.email, 320)
				&& stringUpTo(data.photoUrl, 2048)
				&& data.createdAt is timestamp
				&& data.updatedAt is timestamp;
		}

		// users/{uid}/progress/practice: the best result per lesson, { slug: { quiz, written } }.
		// Mirrors src/app/feature/account/user-data.service.ts. At most 120 lessons.
		function validPractice(data) {
			return data.keys().hasOnly(['scores', 'updatedAt'])
				&& data.scores is map
				&& data.scores.size() <= 120
				&& data.updatedAt is timestamp;
		}

		// users/{uid}/progress/systems: the systems built out of lessons. At most 50 systems.
		function validSystems(data) {
			return data.keys().hasOnly(['items', 'updatedAt'])
				&& data.items is list
				&& data.items.size() <= 50
				&& data.updatedAt is timestamp;
		}

		// users/{uid}/progress/reading: the slugs of the lessons marked as read. At most 120.
		function validReading(data) {
			return data.keys().hasOnly(['read', 'updatedAt'])
				&& data.read is list
				&& data.read.size() <= 120
				&& data.updatedAt is timestamp;
		}

		// shared/{shareId}: the read-only copy of a system, opened by its long random id. Anyone can read one
		// by id (there is no listing); only the user who made it can write or remove it.
		function validShared(data) {
			return data.keys().hasOnly(['ownerUid', 'name', 'nodes', 'links', 'groups', 'templateId', 'notes', 'showTemplateInfo', 'updatedAt'])
				&& data.ownerUid == request.auth.uid
				&& stringUpTo(data.name, 200)
				&& data.nodes is list && data.nodes.size() <= 300
				&& data.links is list && data.links.size() <= 600
				&& data.groups is list && data.groups.size() <= 60
				&& stringUpTo(data.templateId, 100)
				&& stringUpTo(data.notes, 5000)
				&& data.showTemplateInfo is bool
				&& data.updatedAt is timestamp;
		}

		match /shared/{shareId} {
			allow get: if shareId.size() >= 40;
			allow create: if request.auth != null && shareId.size() >= 40 && validShared(request.resource.data);
			allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid && validShared(request.resource.data);
			allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
		}

		match /users/{uid} {
			allow read: if isOwner(uid);
			allow create, update: if isOwner(uid) && validProfile(request.resource.data);
			allow delete: if isOwner(uid);

			match /progress/{id} {
				allow read, delete: if isOwner(uid);
				allow create, update: if isOwner(uid)
					&& (((id == 'practice' || id == 'cooking-practice') && validPractice(request.resource.data))
						|| (id == 'systems' && validSystems(request.resource.data))
						|| ((id == 'reading' || id == 'cooking-reading') && validReading(request.resource.data)));
			}
		}
	}
}
